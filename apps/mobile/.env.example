# Lokale iOS-Simulator-Verbindung
EXPO_PUBLIC_SUPABASE_URL_IOS=http://127.0.0.1:54321

# Android Emulator erreicht den Host über 10.0.2.2.
EXPO_PUBLIC_SUPABASE_URL_ANDROID=http://10.0.2.2:54321

# Nach `pnpm supabase:status` den lokalen publishable/anon key einsetzen.
# Dieser Schlüssel ist für Client-Nutzung bestimmt; niemals den service_role key verwenden.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
