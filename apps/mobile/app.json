{
  "expo": {
    "name": "Salawat Circle",
    "slug": "salawat-circle",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "salawat-circle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "de.salawatcircle.app",
      "supportsTablet": true
    },
    "android": {
      "package": "de.salawatcircle.app",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "de",
              "en"
            ],
            "android": [
              "de",
              "en"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-notifications",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Salawat Circle verwendet deinen ungefähren Standort, um den lokalen Sonnenuntergang für den Freitagsbereich zu berechnen.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "motionUsagePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
