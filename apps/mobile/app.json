{
  "expo": {
    "name": "Salawat Circle",
    "slug": "salawat-circle",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "salawat-circle",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "de.salawatcircle.app",
      "supportsTablet": true
    },
    "android": {
      "package": "de.salawatcircle.app",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["de", "en"],
            "android": ["de", "en"]
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
