{
  "name": "salawat-circle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @salawat-circle/mobile start",
    "dev:android": "pnpm --filter @salawat-circle/mobile android",
    "dev:ios": "pnpm --filter @salawat-circle/mobile ios",
    "lint": "pnpm --filter @salawat-circle/mobile lint",
    "test": "node --test scripts/mvp01-smoke.test.mjs && pnpm --filter @salawat-circle/mobile test",
    "typecheck": "pnpm --filter @salawat-circle/shared-types typecheck && pnpm --filter @salawat-circle/mobile typecheck",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:status": "supabase status",
    "supabase:test": "supabase test db",
    "supabase:stop": "supabase stop",
    "supabase:types": "supabase gen types typescript --local --schema public | sed '${/^$/d;}' > packages/shared-types/src/database.types.ts",
    "test:auth-integration": "node --test scripts/mvp03-auth.integration.test.mjs",
    "test:entries-integration": "node --test scripts/mvp05-entries.integration.test.mjs",
    "test:goals-integration": "node --test scripts/mvp06-goals.integration.test.mjs",
    "test:offline-integration": "node --test scripts/mvp07-offline.integration.test.mjs",
    "test:groups-integration": "node --test scripts/mvp08-groups.integration.test.mjs",
    "test:management-integration": "node --test scripts/mvp09-management.integration.test.mjs",
    "verify": "pnpm test && pnpm lint && pnpm typecheck"
  },
  "devDependencies": {
    "supabase": "2.116.0"
  }
}
